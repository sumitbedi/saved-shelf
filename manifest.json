{
  "manifest_version": 3,
  "name": "Shelf for LinkedIn Saves",
  "short_name": "Shelf",
  "version": "0.1.0",
  "description": "Search your LinkedIn saved posts. Posts you save are kept with their text and the date you saved them, on your computer only.",
  "permissions": ["storage", "scripting"],
  "host_permissions": ["https://www.linkedin.com/*"],
  "background": { "service_worker": "src/bg.js", "type": "module" },
  "action": { "default_title": "Open your shelf" },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "content_scripts": [{
    "matches": ["https://www.linkedin.com/*"],
    "js": ["src/content.js"],
    "run_at": "document_idle",
    "all_frames": false
  }],
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'; img-src 'self'; connect-src 'none'" }
}
